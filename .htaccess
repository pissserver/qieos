# AddType application/json .json

# RewriteEngine On
# RewriteBase /qieos/

# Redirect .php ke tanpa extension (GET saja)
# RewriteCond %{REQUEST_METHOD} GET
# RewriteCond %{THE_REQUEST} \s/+qieos/(.+)\.php[\s?]
# RewriteRule ^ %1 [R=301,L]

# Mapping tanpa extension → file .php
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME}.php -f
# RewriteRule ^(.+)$ $1.php [L]

# Mencegah aset statis tersaji versi lama dari cache browser
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpe?g|gif|ico|svg|woff2?|ttf|eot)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
